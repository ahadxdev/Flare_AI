# Replace with the exact deployed frontend origin (scheme + host + optional port).
# For development: http://localhost:5173,http://127.0.0.1:5173
# For a local production demo: http://localhost:8000
FLARE_CORS_ORIGINS=https://your-frontend.example
FLARE_CORS_ALLOW_METHODS=GET,POST,OPTIONS
FLARE_CORS_ALLOW_HEADERS=Authorization,Content-Type
FLARE_CORS_ALLOW_CREDENTIALS=false
FLARE_LOG_LEVEL=INFO
# Relative paths are resolved from the backend working directory. On Vercel use
# /tmp/flare_ai.sqlite3 because the deployment filesystem is read-only except /tmp.
FLARE_DATABASE_PATH=flare_ai.sqlite3
# Optional OpenAI-compatible chat provider; leave API key and model empty for evidence-only fallback.
FLARE_LLM_API_KEY=
FLARE_LLM_MODEL=
FLARE_LLM_BASE_URL=https://api.openai.com/v1
FLARE_LLM_TIMEOUT_SECONDS=10
# Must exceed the LLM timeout; maximum 120 seconds.
FLARE_REQUEST_TIMEOUT_SECONDS=30
# JSON only; there are no HTTP uploads. Limit counts streamed bytes too.
FLARE_MAX_REQUEST_BYTES=65536
# Seed only an empty catalog using bundled, verified local sources. Never replaces existing records.
FLARE_SEED_ON_START=true
# Serve the production Vite build from dist/ on the same origin as /api.
# Set false for Vite development or a separately hosted frontend with an /api proxy.
FLARE_SERVE_FRONTEND=true
