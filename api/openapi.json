{
  "openapi": "3.1.0",
  "info": {
    "title": "FLARE AI API",
    "description": "Evidence-first NASA PSI investigation discovery and research relevance analysis. Relevance is not fire risk; missing evidence is never inferred.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/health": {
      "get": {
        "tags": [
          "health"
        ],
        "summary": "Check API health",
        "description": "Returns a simple health status for the FLARE AI API.",
        "operationId": "health_api_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HealthResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/investigations": {
      "get": {
        "tags": [
          "investigations"
        ],
        "summary": "Search investigations",
        "description": "Searches and filters the locally indexed canonical investigation catalog. Only imported source-backed records are returned.",
        "operationId": "list_investigations_api_investigations_get",
        "parameters": [
          {
            "name": "q",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 250
                },
                {
                  "type": "null"
                }
              ],
              "title": "Q"
            }
          },
          {
            "name": "research_area",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "prevention",
                    "detection",
                    "suppression",
                    "fundamentals",
                    "related",
                    "other"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Research Area"
            }
          },
          {
            "name": "environment",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "microgravity",
                    "normal_gravity",
                    "other",
                    "unknown"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Environment"
            }
          },
          {
            "name": "data_availability",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "enum": [
                    "metadata_only",
                    "documents",
                    "numeric_dataset",
                    "unknown"
                  ],
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Data Availability"
            }
          },
          {
            "name": "page",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 1,
              "default": 1,
              "title": "Page"
            }
          },
          {
            "name": "page_size",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 100,
              "minimum": 1,
              "default": 20,
              "title": "Page Size"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/InvestigationPage"
                }
              }
            }
          },
          "404": {
            "description": "Requested record was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/investigations/{investigation_id}": {
      "get": {
        "tags": [
          "investigations"
        ],
        "summary": "Get an investigation",
        "description": "Returns one canonical investigation, including its source provenance.",
        "operationId": "get_investigation_api_investigations__investigation_id__get",
        "parameters": [
          {
            "name": "investigation_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "title": "Investigation Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Investigation"
                }
              }
            }
          },
          "404": {
            "description": "Requested record was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/scenarios/analyze": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Analyze scenario research relevance",
        "description": "Ranks indexed investigations by transparent research relevance. The score is not a fire-risk score or probability; user-entered conditions remain hypothetical.",
        "operationId": "analyze_scenario_api_scenarios_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ScenarioRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ScenarioAnalysisResponse"
                }
              }
            }
          },
          "404": {
            "description": "Requested record was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/compare": {
      "post": {
        "tags": [
          "analysis"
        ],
        "summary": "Compare investigations",
        "description": "Returns requested source-backed records for side-by-side comparison. Unavailable fields are not inferred.",
        "operationId": "compare_api_compare_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ComparisonRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ComparisonResponse"
                }
              }
            }
          },
          "404": {
            "description": "Requested record was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/chat": {
      "post": {
        "tags": [
          "evidence"
        ],
        "summary": "Ask an evidence-grounded question",
        "description": "Retrieves verified excerpts and returns citations linked to those excerpts. When evidence is unavailable, returns answer_status=insufficient_evidence rather than guessing. Optional scenario context uses a prior scenario analysis.",
        "operationId": "chat_api_chat_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ChatRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ChatResponse"
                }
              }
            }
          },
          "404": {
            "description": "Requested record was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/measurements": {
      "get": {
        "tags": [
          "evidence"
        ],
        "summary": "List verified measurements",
        "description": "Returns source-linked numeric measurements only. Empty results mean no verified matching measurements are indexed.",
        "operationId": "measurements_api_measurements_get",
        "parameters": [
          {
            "name": "investigation_id",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "title": "Investigation Id"
            }
          },
          {
            "name": "variable",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "type": "string",
                  "maxLength": 200
                },
                {
                  "type": "null"
                }
              ],
              "title": "Variable"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/MeasurementList"
                }
              }
            }
          },
          "404": {
            "description": "Requested record was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    },
    "/api/reports": {
      "post": {
        "tags": [
          "reports"
        ],
        "summary": "Generate an evidence brief",
        "description": "Builds a metadata-based brief for selected investigations and includes source references, limitations, and known research gaps.",
        "operationId": "create_report_api_reports_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReportRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ReportResponse"
                }
              }
            }
          },
          "404": {
            "description": "Requested record was not found.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "422": {
            "description": "Request validation failed.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          },
          "500": {
            "description": "Unexpected server error.",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "ChatEvidence": {
        "properties": {
          "source_id": {
            "type": "string",
            "title": "Source Id"
          },
          "investigation_id": {
            "type": "string",
            "title": "Investigation Id"
          },
          "document_title": {
            "type": "string",
            "title": "Document Title"
          },
          "source_url": {
            "type": "string",
            "maxLength": 2083,
            "minLength": 1,
            "format": "uri",
            "title": "Source Url"
          },
          "page_number": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Page Number"
          },
          "section": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Section"
          },
          "excerpt": {
            "type": "string",
            "title": "Excerpt"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source_id",
          "investigation_id",
          "document_title",
          "source_url",
          "excerpt"
        ],
        "title": "ChatEvidence"
      },
      "ChatRequest": {
        "properties": {
          "question": {
            "type": "string",
            "maxLength": 4000,
            "minLength": 1,
            "title": "Question"
          },
          "scenario_id": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 100,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Scenario Id"
          },
          "investigation_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "title": "Investigation Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "question"
        ],
        "title": "ChatRequest"
      },
      "ChatResponse": {
        "properties": {
          "answer": {
            "type": "string",
            "title": "Answer"
          },
          "evidence": {
            "items": {
              "$ref": "#/components/schemas/ChatEvidence"
            },
            "type": "array",
            "title": "Evidence"
          },
          "citations": {
            "items": {
              "$ref": "#/components/schemas/SourceCitation"
            },
            "type": "array",
            "title": "Citations"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          },
          "answer_status": {
            "type": "string",
            "enum": [
              "grounded",
              "insufficient_evidence"
            ],
            "title": "Answer Status"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "answer",
          "evidence",
          "citations",
          "limitations",
          "answer_status"
        ],
        "title": "ChatResponse"
      },
      "ComparisonRequest": {
        "properties": {
          "investigation_ids": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "maxItems": 5,
            "minItems": 1,
            "title": "Investigation Ids"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "investigation_ids"
        ],
        "title": "ComparisonRequest"
      },
      "ComparisonResponse": {
        "properties": {
          "investigations": {
            "items": {
              "$ref": "#/components/schemas/Investigation"
            },
            "type": "array",
            "title": "Investigations"
          },
          "limitations": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Limitations"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "investigations",
          "limitations"
        ],
        "title": "ComparisonResponse"
      },
      "ErrorBody": {
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "VALIDATION_ERROR",
              "NOT_FOUND",
              "NO_EVIDENCE",
              "INTERNAL_ERROR"
            ],
            "title": "Code"
          },
          "message": {
            "type": "string",
            "title": "Message"
          },
          "details": {
            "items": {
              "$ref": "#/components/schemas/ErrorDetail"
            },
            "type": "array",
            "title": "Details"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "code",
          "message"
        ],
        "title": "ErrorBody"
      },
      "ErrorDetail": {
        "properties": {
          "field": {
            "type": "string",
            "title": "Field"
          },
          "message": {
            "type": "string",
            "title": "Message"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "field",
          "message"
        ],
        "title": "ErrorDetail"
      },
      "ErrorResponse": {
        "properties": {
          "error": {
            "$ref": "#/components/schemas/ErrorBody"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "error"
        ],
        "title": "ErrorResponse"
      },
      "HealthResponse": {
        "properties": {
          "status": {
            "type": "string",
            "const": "ok",
            "title": "Status",
            "default": "ok"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "HealthResponse"
      },
      "Investigation": {
        "properties": {
          "investigation_id": {
            "type": "string",
            "minLength": 1,
            "title": "Investigation Id"
          },
          "title": {
            "type": "string",
            "minLength": 1,
            "title": "Title"
          },
          "acronym": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Acronym"
          },
          "research_area": {
            "type": "string",
            "enum": [
              "prevention",
              "detection",
              "suppression",
              "fundamentals",
              "related",
              "other"
            ],
            "title": "Research Area"
          },
          "objectives": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Objectives"
          },
          "materials_or_fuels": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Materials Or Fuels"
          },
          "environment": {
            "type": "string",
            "enum": [
              "microgravity",
              "normal_gravity",
              "other",
              "unknown"
            ],
            "title": "Environment",
            "default": "unknown"
          },
          "conditions": {
            "$ref": "#/components/schemas/InvestigationConditions"
          },
          "hardware": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Hardware"
          },
          "sensors": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Sensors"
          },
          "variables_measured": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Variables Measured"
          },
          "findings": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Findings"
          },
          "data_availability": {
            "type": "string",
            "enum": [
              "metadata_only",
              "documents",
              "numeric_dataset",
              "unknown"
            ],
            "title": "Data Availability",
            "default": "unknown"
          },
          "sources": {
            "items": {
              "$ref": "#/components/schemas/Source"
            },
            "type": "array",
            "title": "Sources"
          },
          "last_verified_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Last Verified At"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "investigation_id",
          "title",
          "research_area"
        ],
        "title": "Investigation"
      },
      "InvestigationConditions": {
        "properties": {
          "oxygen_pct": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 100.0,
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Oxygen Pct"
          },
          "pressure": {
            "$ref": "#/components/schemas/Pressure"
          },
          "other": {
            "items": {
              "type": "string"
            },
            "type": "array",
            "title": "Other"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "InvestigationConditions"
      },
      "InvestigationPage": {
        "properties": {
          "items": {
            "items": {
              "$ref": "#/components/schemas/Investigation"
            },
            "type": "array",
            "title": "Items"
          },
          "page": {
            "type": "integer",
            "title": "Page"
          },
          "page_size": {
            "type": "integer",
            "title": "Page Size"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "items",
          "page",
          "page_size",
          "total"
        ],
        "title": "InvestigationPage"
      },
      "Measurement": {
        "properties": {
          "measurement_id": {
            "type": "string",
            "minLength": 1,
            "title": "Measurement Id"
          },
          "investigation_id": {
            "type": "string",
            "minLength": 1,
            "title": "Investigation Id"
          },
          "variable": {
            "type": "string",
            "minLength": 1,
            "title": "Variable"
          },
          "value": {
            "type": "number",
            "title": "Value"
          },
          "unit": {
            "type": "string",
            "minLength": 1,
            "title": "Unit"
          },
          "source_id": {
            "type": "string",
            "minLength": 1,
            "title": "Source Id"
          },
          "conditions": {
            "additionalProperties": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "number"
                },
                {
                  "type": "null"
                }
              ]
            },
            "type": "object",
            "title": "Conditions"
          }
